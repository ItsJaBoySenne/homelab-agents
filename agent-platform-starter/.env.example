# Copy to .env (chmod 600). Never commit or paste real values.

# --- Required -------------------------------------------------------------
OPENROUTER_API_KEY=replace_me
# Host address the dashboard/API port 8088 listens on (compose.yaml). 127.0.0.1 = this machine only; set your VM's
# LAN IP (e.g. 192.168.1.10) when the reverse proxy runs on another host.
HLA_LISTEN_ADDRESS=127.0.0.1

# Optional (HLA_RISK_REVIEW_V1): the TypeSafe risk review, off by default. On, every request is scored first and
# risk >= 0.40 is held for approval (unhinged mode skips the hold); needs TYPESAFE_API_KEY.
HLA_RISK_REVIEW=false
TYPESAFE_API_KEY=replace_me
TYPESAFE_MODEL=jev-latest
# Optional (HLA_XAI_V1): xAI's API key for Grok models called directly (model ids xai/<model>, billed to your xAI
# credits). Without it, xai/... models fail with a clear error; OpenRouter's x-ai/... ids keep using OPENROUTER_API_KEY.
XAI_API_KEY=

# --- The Chief (HLA_CHIEF_V1; optional) -----------------------------------------
# Daily budget given to the Chief agent when it is created (edit it later on the Agents page).
# HLA_CHIEF_DAILY_BUDGET=2

# --- Attachments (HLA_ATTACHMENTS_V1; all optional, defaults shown) -------
# Photos, files and documents in conversations, projects and tasks. Stored on the agent_attachments volume.
# HLA_ATTACHMENT_MAX_MB=20              # per file
# HLA_ATTACHMENTS_PER_MESSAGE=10        # per message / task / new project
# HLA_ATTACHMENT_PROMPT_CHARS=30000     # document text put into one prompt (the rest via attachment_read)
# HLA_ATTACHMENT_PROJECT_CHARS=12000    # project reference-file text in the planner and task prompts
# HLA_ATTACHMENT_MAX_IMAGES=6           # images sent to a model per run (downscaled to 1568 px)
# HLA_VISION_MODELS=                    # comma list: treat these models as able to see images
# HLA_NO_VISION_MODELS=                 # comma list: never send images to these models
# Models are managed on the dashboard's Models page (model registry). These two only seed it: on startup an empty
# registry is filled from AGENT_ALLOWED_MODELS plus OPENROUTER_WORKER_MODEL, and while it is empty they are the
# allowlist again. OPENROUTER_WORKER_MODEL stays the default model until one is chosen on the Models page.
OPENROUTER_WORKER_MODEL=provider/model
# Comma-separated models agents and conversations may select (seed / fallback of the registry).
AGENT_ALLOWED_MODELS=provider/model
# openssl rand -hex 32
AGENT_PLATFORM_TOKEN=replace_with_long_random_secret
DASHBOARD_PASSWORD=replace_me
POSTGRES_USER=agents
POSTGRES_DB=agent_platform
POSTGRES_PASSWORD=replace_me

# --- Model behaviour --------------------------------------------------------
DEFAULT_REASONING_EFFORT=low
# Output tokens per reply. Empty "Max tokens" in the dashboard = unlimited (no limit sent to the model);
# this only caps a number someone types (and API requests). 0 or unset = no cap.
HLA_MAX_OUTPUT_TOKENS=0
# Tool calls an agent may make per reply (4-40); after that it must report what it found.
HLA_MAX_TOOL_CALLS=16
# Tool calls per turn for project tasks (4-80; building needs more steps than chat).
HLA_PROJECT_TOOL_CALLS=40
# Knowledge (notes and facts) put into each run's context, in characters (0 switches it off).
HLA_KB_CONTEXT_CHARS=6000
# Conversation history per prompt, in characters (4000-50000). Older turns are folded into a rolling summary.
HLA_HISTORY_CHARS=24000
# Output limit of that summary call, and its model (empty: the conversation's own model, else the default model).
HLA_SUMMARY_TOKENS=700
HLA_SUMMARY_MODEL=
# Models per kind of work (empty: the agent's own model). Must be enabled in the model registry. These are defaults: the
# Models page ("Models per kind of work") can change them, with per-project overrides. HLA_SUMMARY_MODEL above is the
# default for conversation summaries.
HLA_MODEL_PLAN=
HLA_MODEL_REVIEW=
# Checkpoint and automatic continuations of project tasks.
HLA_MODEL_CONTINUE=

# --- Proxmox inventory (read-only API token) ---------------------------------
# Only the Proxmox context added to agent prompts and GET /infrastructure/proxmox use this token. The dashboard's
# Infrastructure view, VM creation and the agents' proxmox tool go through the SSH gateway, whose node tokens live in
# Infisical (/Proxmox/Node_1, /Proxmox/Node_2) and whose settings (PROXMOX_ALLOWED_NETS, CA files) are in
# ../ssh-gateway/.env.gateway; nothing to set here for them.
PROXMOX_API_URL=https://proxmox.home.arpa:8006
PROXMOX_TOKEN_ID=user@pve!token
PROXMOX_TOKEN_SECRET=replace_me

# --- SSH tools via ../ssh-gateway --------------------------------------------
# Which agent may do what on which server is set on the dashboard's Policy page (stored in the gateway).
SSH_TOOL_ENABLED=false
# Same value as TOOL_GATEWAY_TOKEN in ../ssh-gateway/.env.gateway (>= 32 chars).
TOOL_GATEWAY_TOKEN=
# Same value as POLICY_ADMIN_TOKEN in .env.gateway; needed to edit policy from the dashboard. Must differ from TOOL_GATEWAY_TOKEN.
POLICY_ADMIN_TOKEN=
# Pre-policy SSH agent: given level 5 once when the policy has no agents yet; also the agent allowed the secret workflow.
SSH_TOOL_AGENT_ID=
# Lets a single allowlisted dev maintenance request pass the TypeSafe risk hold.
HLA_DEV_MAINTENANCE_RISK_EXCEPTION=false

# --- Sandbox reset (sandbox-vm, VM 204 on pve2) ------------------------------
# Token limited to VM.Snapshot.Rollback + VM.PowerMgmt on that VM. TLS is checked against pve2-ca.pem
# (pve2's /etc/pve/pve-root-ca.pem, placed next to this file). URL/node/VM/snapshot have these defaults.
SANDBOX_PROXMOX_TOKEN_ID=Agents@pam!agents
SANDBOX_PROXMOX_TOKEN_SECRET=
# SANDBOX_PROXMOX_URL=https://192.168.20.31:8006
# SANDBOX_PROXMOX_NODE=pve2
# SANDBOX_VMID=204
# SANDBOX_SNAPSHOT=clean

# --- Knowledge -----------------------------------------------------------------
# weekly: re-run the read-only diagnostic behind stale facts once a week (at most 20 per run). Anything else: off
# ("Re-check now" on the Knowledge page works either way).
HLA_FACT_RECHECK=

# --- Approvals -----------------------------------------------------------------
# Authelia's Remote-User/Remote-Groups are trusted only from these proxy IPs (Traefik).
HLA_TRUSTED_PROXY_IPS=
# Naming approvers makes a verified identity mandatory for approve/reject.
HLA_APPROVER_USERS=
HLA_APPROVER_GROUPS=
# Require any verified Authelia user even without an approver list.
HLA_REQUIRE_APPROVER_IDENTITY=false
HLA_APPROVAL_TTL_HOURS=72

# --- Generated secrets (the gateway's secret store, generated namespace) ------
# The "CREATE_DEV_SECRET name=HLA_DEV_... kind=password" workflow asks the gateway (POST /v1/secrets) as the
# SSH_TOOL_AGENT_ID agent, which needs level 4 on the secrets service. Where the value is stored (the local encrypted
# file or Infisical) is set in ../ssh-gateway/.env.gateway (HLA_SECRETS_BACKEND).
AGENT_SECRET_WRITER_ENABLED=false
HLA_DEV_SECRET_WORKFLOW=false

# --- Database backups (service "backup"; see README "Backups") --------------
# Nightly pg_dump into ./backups at BACKUP_TIME in BACKUP_TZ; keeps the newest dump of each of the last
# BACKUP_KEEP_DAYS days plus the newest of each of the last BACKUP_KEEP_WEEKS weeks.
BACKUP_TIME=03:30
BACKUP_TZ=UTC
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_WEEKS=8
# Websites view (websites.py): check the websites on public-website every N minutes; production sites that go down
# (or come back) send a push notification and wait in "Needs you". 0 switches the monitor off.
HLA_WEBSITE_CHECK_MINUTES=5
# Domains & routes (public_routes.py) need POLICY_ADMIN_TOKEN (above) to manage the gateway's Traefik routes; the settings
# (managed file, backup folder, cert resolver, public IP) are in ../ssh-gateway/.env.gateway.
# --- Voice: the Chief's car mode (voice.py; see README "Voice: the Chief's car mode") -------------------------------
# Optional. Without these, car mode listens and speaks with the phone's browser. Set a base URL to offer "Server" in
# car mode's settings: any OpenAI-compatible speech service (self-hosted speaches/faster-whisper, or OpenAI).
# The keys stay here; the browser never sees them.
VOICE_STT_BASE_URL=
VOICE_STT_API_KEY=
VOICE_STT_MODEL=whisper-1
VOICE_STT_LANGUAGE=nl
# Local Kokoro (compose service "kokoro"): http://kokoro:8880/v1 with VOICE_TTS_MODEL=kokoro, VOICE_TTS_VOICE=af_heart
VOICE_TTS_BASE_URL=
VOICE_TTS_API_KEY=
VOICE_TTS_MODEL=tts-1
VOICE_TTS_VOICE=alloy
# Voices offered in car mode's picker (comma-separated); default: VOICE_TTS_VOICE only.
VOICE_TTS_VOICES=
# Chief car mode speed (HLA_CHIEF_LATENCY_V1): snapshot size in a spoken turn's prompt, and its history.
HLA_CHIEF_SNAPSHOT_CHARS=2500
HLA_VOICE_HISTORY_MESSAGES=16
HLA_VOICE_HISTORY_CHARS=6000
# --- Subscription engines (engines.py; see README "Subscription engines") ------------------------------------------
# Optional. Agents can run on your own Claude (Pro/Max) or ChatGPT (Plus/Pro) plan through the official Claude Code /
# Codex CLIs in the router image: sign them in on the Subscriptions page. No keys here: the sign-ins live in the
# engine_auth volume. The defaults are fine; these only override them.
# HLA_ENGINES_DIR=/data/engines
# Model names offered per engine (comma-separated, name or name=Label). Defaults: sonnet, opus, haiku, fable / gpt-6.1-sol,
# gpt-6-astra, gpt-6.1-terra, gpt-6-sol, gpt-6-luna, gpt-5.5.
# HLA_CLAUDE_SUB_MODELS=sonnet,opus
# HLA_CHATGPT_SUB_MODELS=gpt-6.1-sol=GPT-6.1-Sol
# Seconds an engine may stay silent before the run fails (default 600).
# HLA_ENGINE_TIMEOUT=600
