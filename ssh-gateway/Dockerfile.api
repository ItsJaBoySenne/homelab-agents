FROM python:3.12-slim
WORKDIR /srv
RUN pip install --no-cache-dir 'paramiko>=3.5,<5'
COPY gateway /srv/gateway
COPY gateway_api /srv/gateway_api
# HLA_PROXMOX_V1: the Proxmox nodes' CA certificates (public; ./dc copies them from ../agent-platform-starter).
COPY certs/ /srv/certs/
RUN chmod 0755 /srv/certs && chmod 0644 /srv/certs/*
RUN mkdir /data && chown 65532:65532 /data
USER 65532:65532
CMD ["python", "-m", "gateway_api.server"]
