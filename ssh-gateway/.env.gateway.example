# Copy to .env.gateway (chmod 600). The gateway's own Infisical machine identity (read-only on /servers/*).
INFISICAL_URL=https://infisical.example
INFISICAL_CLIENT_ID=REPLACE_ME
INFISICAL_CLIENT_SECRET=REPLACE_ME
INFISICAL_PROJECT_ID=REPLACE_ME
INFISICAL_ENV=prod
# Agent secrets (gateway/agent_secrets.py): a SEPARATE project ("Agent Generated") with its own machine identity that
# can read and write there. Leave the project empty to switch the feature off. Without the two client settings the
# identity above is used. Optional: INFISICAL_GENERATED_ENV (default INFISICAL_ENV), INFISICAL_GENERATED_PATH (default /).
INFISICAL_GENERATED_PROJECT_ID=
INFISICAL_GENERATED_CLIENT_ID=
INFISICAL_GENERATED_CLIENT_SECRET=
# GitHub pull requests (gateway/github.py): a token with Contents read/write and Pull requests read/write on the
# repositories you allow on the Policy page. Either here, or (preferred) GITHUB_TOKEN in this Infisical folder of the
# servers project. With neither, the github service answers github_not_configured. A GITHUB_TOKEN stored on the
# dashboard (Connections page, credential store below) takes precedence over both.
GITHUB_TOKEN=
INFISICAL_GITHUB_PATH=/GitHub
# Shared with the agent platform's .env; at least 32 characters (openssl rand -hex 32).
TOOL_GATEWAY_TOKEN=REPLACE_ME
# Lets the dashboard change policy (levels, unhinged mode). Without it, policy is read-only. Differs from TOOL_GATEWAY_TOKEN.
POLICY_ADMIN_TOKEN=REPLACE_ME
# Credential store (gateway/credentials.py): tokens for connections entered on the dashboard, AES-GCM encrypted in the
# gateway database. 32 random bytes, base64: openssl rand -base64 32. Without it the store is off. Keep it secret;
# losing it only means re-entering the stored credentials.
GATEWAY_CREDENTIAL_KEY=
# Websites inventory (gateway/websites.py): the Traefik API as seen on the traefik host, and the file provider folder read
# when the API does not answer. Extra host names of the website VM used in Traefik backend URLs (comma-separated).
TRAEFIK_API_URL=http://127.0.0.1:8080
TRAEFIK_DYNAMIC_DIR=/opt/traefik/dynamic
WEBSITE_BACKEND_HOSTS=
# Managed routes (gateway/routes.py): the one file the gateway writes on the traefik host, the backup folder (never inside
# the file's folder: Traefik loads every file there), the cert resolver (empty = the one most routers use) and the public
# address(es) DNS must point at (comma-separated).
TRAEFIK_MANAGED_FILE=/opt/traefik/dynamic/hla-managed.yml
TRAEFIK_ROUTE_BACKUP_DIR=/opt/traefik/managed-backups
TRAEFIK_CERT_RESOLVER=
PUBLIC_IPS=203.0.113.10
# Proxmox (gateway/proxmox.py): node tokens come from Infisical /Proxmox/Node_1 and /Proxmox/Node_2 (NODE_IP, NODE_PORT,
# TOKEN_ID, TOKEN_SECRET). New VMs may only get addresses in these networks (comma-separated). Agents never power or roll
# back VMs with these names. CA files: certs/proxmox-ca.pem and certs/pve2-ca.pem in the image (./dc copies them);
# PROXMOX_CA_DIR, PROXMOX_CA_PROXMOX, PROXMOX_CA_PVE2, PROXMOX_TLS_NAME_PROXMOX, PROXMOX_TLS_NAME_PVE2 override them.
PROXMOX_ALLOWED_NETS=192.168.10.0/24
PROXMOX_PROTECTED_NAMES=agents-vm,secrets-vm
# Omada controller (gateway/omada.py): the Open API app (Client mode) comes from Infisical /Omada (APPLICATION_NAME,
# CLIENT_ID, CLIENT_SECRET). The controller is pinned to https://192.168.20.101:8043; OMADA_URL may only change the port.
# Its certificate is pinned by SHA-256 (trusted on the dashboard), unless certs/omada-ca.pem exists (or OMADA_CA points at
# a CA file); OMADA_TLS_NAME then also checks the certificate name.
# OMADA_URL=https://192.168.20.101:8043
