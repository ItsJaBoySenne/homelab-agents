# Copy to .env.gateway (chmod 600).
# Secret store (gateway/secret_store.py; README "Secret store"): local (default) = an encrypted file on the
# gateway_secrets volume (/data/secrets/secrets.enc), or infisical = the INFISICAL_* settings below.
HLA_SECRETS_BACKEND=local
# 32 random bytes, base64. Generate: python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Losing it loses the stored secrets; back it up apart from the volume. Also keys the credential store when
# GATEWAY_CREDENTIAL_KEY is empty.
HLA_SECRETS_KEY=
# Where secrets.enc lives inside the container (the gateway_secrets volume).
HLA_SECRETS_DIR=/data/secrets
# The inventory (servers and integrations), mounted read-only from ../config/inventory.yaml.
HLA_INVENTORY=/config/inventory.yaml

# --- Only with HLA_SECRETS_BACKEND=infisical ---------------------------------------------------------------------
# The gateway's own Infisical machine identity (read-only on the platform folders: /servers/<name>, /Proxmox/<node>,
# /Omada, /HomeAssistant, /GitHub).
INFISICAL_URL=
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENV=prod
# Agent secrets (gateway/agent_secrets.py): a SEPARATE project ("Agent Generated") with its own machine identity that
# can read and write there. Leave the project empty to switch the feature off. Without the two client settings the
# identity above is used. Optional: INFISICAL_GENERATED_ENV (default INFISICAL_ENV), INFISICAL_GENERATED_PATH (default /).
INFISICAL_GENERATED_PROJECT_ID=
INFISICAL_GENERATED_CLIENT_ID=
INFISICAL_GENERATED_CLIENT_SECRET=
# Folder of GITHUB_TOKEN in the platform namespace (default /GitHub; any backend).
INFISICAL_GITHUB_PATH=
# -----------------------------------------------------------------------------------------------------------------

# GitHub pull requests (gateway/github.py; needs services.github in the inventory): a token with Contents read/write and
# Pull requests read/write on the repositories you allow on the Policy page. Order: the dashboard's credential store
# (Connections page), then GITHUB_TOKEN here, then GitHub/GITHUB_TOKEN in the secret store.
GITHUB_TOKEN=
# Shared with the agent platform's .env; at least 32 characters (openssl rand -hex 32).
TOOL_GATEWAY_TOKEN=REPLACE_ME
# Lets the dashboard change policy (levels, unhinged mode). Without it, policy is read-only. Differs from TOOL_GATEWAY_TOKEN.
POLICY_ADMIN_TOKEN=REPLACE_ME
# Credential store (gateway/credentials.py): tokens for connections entered on the dashboard, AES-GCM encrypted in the
# gateway database. 32 random bytes, base64: openssl rand -base64 32. Empty: a key derived from HLA_SECRETS_KEY (set it
# here only if you want a separate key; changing it later makes stored credentials unreadable). Keep it secret;
# losing it only means re-entering the stored credentials.
GATEWAY_CREDENTIAL_KEY=
# Websites inventory (gateway/websites.py): the Traefik API as seen on the traefik host, and the file provider folder read
# when the API does not answer. Extra host names of the website VM used in Traefik backend URLs (comma-separated).
TRAEFIK_API_URL=http://127.0.0.1:8080
TRAEFIK_DYNAMIC_DIR=/opt/traefik/dynamic
WEBSITE_BACKEND_HOSTS=
# Managed routes (gateway/routes.py): the one file the gateway writes on the traefik host, the backup folder (never inside
# the file's folder: Traefik loads every file there), the cert resolver (empty = the one most routers use) and the public
# address(es) DNS must point at (comma-separated; empty = public_ips from the inventory).
TRAEFIK_MANAGED_FILE=/opt/traefik/dynamic/hla-managed.yml
TRAEFIK_ROUTE_BACKUP_DIR=/opt/traefik/managed-backups
TRAEFIK_CERT_RESOLVER=
PUBLIC_IPS=
# Proxmox (gateway/proxmox.py; nodes in the inventory): node tokens are Proxmox/<node>/TOKEN_ID and TOKEN_SECRET in the
# secret store. New VMs may only get addresses in these networks (comma-separated). Agents never power or roll back VMs
# with these names. CA files: certs/<node>-ca.pem in the image; PROXMOX_CA_DIR, PROXMOX_CA_<NODE>, PROXMOX_TLS_NAME_<NODE>
# override them.
PROXMOX_ALLOWED_NETS=192.168.10.0/24
PROXMOX_PROTECTED_NAMES=agents-vm,secrets-vm
# Omada controller (gateway/omada.py; services.omada in the inventory): the Open API app (Client mode) is Omada/CLIENT_ID
# and Omada/CLIENT_SECRET in the secret store. The controller is pinned to the inventory URL; OMADA_URL may only change the port.
# Its certificate is pinned by SHA-256 (trusted on the dashboard), unless certs/omada-ca.pem exists (or OMADA_CA points at
# a CA file); OMADA_TLS_NAME then also checks the certificate name.
# OMADA_URL=https://192.168.1.2:8043
