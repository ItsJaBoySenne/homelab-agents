#!/bin/sh
# docker compose for the gateway API with its base file, so commands stay short: sudo ./dc ps -a
cd "$(dirname "$0")" || exit 1
# The Proxmox CA certificates the gateway checks the nodes against (public certs; *.pem stays out of git).
for p in ../agent-platform-starter/*-ca.pem; do
  f=$(basename "$p")
  [ -f "certs/$f" ] || [ ! -f "$p" ] || cp "$p" "certs/$f"
done
exec docker compose -f compose.yaml -f compose.tools-api.yaml "$@"
